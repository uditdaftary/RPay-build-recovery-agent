RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Set this in the Razorpay dashboard under Settings > Webhooks, then paste it here.
# It is NOT the key secret. Webhook bodies are signed with this and only this.
RAZORPAY_WEBHOOK_SECRET=

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Optional: comma-separated fallback chain tried in order if primary returns a retryable error.
# The two -lite entries are unmeasured capacity headroom; gemini-flash-latest is last
# because it is the only floating alias, so it survives a pinned version being retired.
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest

# Public origin Razorpay can reach for webhooks (ngrok/cloudflared during development).
PUBLIC_BASE_URL=http://localhost:8000

# Durable state. Unset, the audit log is an append-only file and operator state lives in
# process memory, which is correct on one machine. Set, the log, the invoice lifecycle, the
# kill switch and the review queue move to Postgres, which is what serverless requires:
# there, the instance that serves the payment is rarely the one that served the page.
DATABASE_URL=

# Operator console. No default: an unset key is a 401, never a shared secret.
OPERATOR_API_KEY=

# Outbound email. Live sending needs all three, and refuses to arm without them, so
# provisioning a key ahead of a demo cannot silently arm the whole portfolio.
SEND_MODE=sandbox
RESEND_API_KEY=
FROM_EMAIL=recovery@msme-agent.in

# The single address this deployment may write to. Every drafted message is redirected
# here with the intended recipient preserved in the subject, so a wrong contact entry
# cannot put a legal notice in a stranger's inbox.
ALLOWED_RECIPIENT=

# Debtor contacts as inline JSON, for deployments with no writable filesystem.
# {"DEB-001": {"email": "ap@buyer.example", "phone": "+919000000000"}}
DEBTOR_CONTACTS=
