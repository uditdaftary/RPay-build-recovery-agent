RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Set this in the Razorpay dashboard under Settings > Webhooks, then paste it here.
# It is NOT the key secret. Webhook bodies are signed with this and only this.
RAZORPAY_WEBHOOK_SECRET=

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Comma-separated fallback chain tried in order if primary returns a retryable error
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest

# Public origin Razorpay can reach for webhooks (ngrok/cloudflared during development).
PUBLIC_BASE_URL=http://localhost:8000
